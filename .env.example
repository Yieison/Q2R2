DATABASE_URL=
SESSION_SECRET=
# Optional dedicated QR key: exactly 64 hexadecimal characters.
QR_ENCRYPTION_KEY=
# Optional one-time support through Wompi. Omit all three to disable support.
# The *_PROD variants take precedence when both are set; sandbox mode is
# detected from a pub_test_ public key.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_PRIVATE_KEY=
# Canonical public origin for SEO metadata (defaults to the request host).
PUBLIC_URL=
# Express trust proxy setting: number of proxy hops, true/false or a subnet list.
# Default 1 (one reverse proxy). Use 0 when the app is exposed directly.
TRUST_PROXY=1
PORT=5000